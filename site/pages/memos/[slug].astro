---
import Icon from "@/components/ui/Icon";
import { extractTextSummary } from "@/lib/markdown-utils";
import MarkdownRenderer from "@/components/common/MarkdownRenderer";
import { stripMatchingLeadingTitleHeading } from "@/lib/markdown-utils";
import type { PublicMemoRecord } from "@/public-site/snapshot";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PublicMemoDetailControlsIsland } from "@console-memo-authoring";
import TagBadge from "../../components/TagBadge.astro";
import { formatAbsoluteDate, formatDateTime } from "../../lib/format";
import { getCanonicalUrl, getMemoBySlug, getMemoMetadataTitle, getSnapshot } from "../../lib/public-site";
import {
  getMemoListWebDemoRecord,
  getMemoListWebDemoRecords,
} from "../../lib/memo-list-web-demo";

export async function getStaticPaths() {
  if (process.env.WEB_DEMO_BUILD === "true") {
    return getMemoListWebDemoRecords().map((memo) => ({
      params: { slug: memo.slug },
      props: { memo },
    }));
  }

  const snapshot = await getSnapshot();
  return snapshot.memos.map((memo) => ({
    params: { slug: memo.slug },
    props: { memo },
  }));
}

const snapshot = await getSnapshot();
const memoFromProps = (Astro.props as { memo?: PublicMemoRecord }).memo;
const memo =
  memoFromProps ??
  (process.env.WEB_DEMO_BUILD === "true"
    ? getMemoListWebDemoRecord(Astro.params.slug ?? "")
    : getMemoBySlug(snapshot, Astro.params.slug ?? ""));
if (!memo) return new Response("Not Found", { status: 404 });
const displayDate = memo.publishedAt ?? memo.createdAt;
const metadataTitle = getMemoMetadataTitle(memo.title, displayDate);
const contentSource = "local" as const;
const publicMediaContext = { kind: "memo" as const, slug: memo.slug, filePath: memo.filePath };
const memoDescription = extractTextSummary(memo.content, 180) || snapshot.site.description;
const memoDetailContent = stripMatchingLeadingTitleHeading(memo.content, memo.title);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: metadataTitle,
  description: memoDescription,
  datePublished: displayDate,
  dateModified: memo.updatedAt ?? displayDate,
  author: {
    "@type": "Person",
    name: snapshot.site.author.name,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": getCanonicalUrl(`/memos/${memo.slug}`),
  },
};
---
<BaseLayout
  pathname={`/memos/${memo.slug}`}
  title={`${metadataTitle} - ${snapshot.site.title}`}
  description={memoDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="nature-detail-container memo-detail-layout px-2 py-8 sm:px-6 sm:py-10">
    <article class="nature-reading-measure space-y-8">
      {process.env.CONSOLE_RUNTIME === "true" ? (
        <PublicMemoDetailControlsIsland client:load slug={memo.slug} />
      ) : null}

      <div data-public-memo-static-shell>
        <div class="nature-panel nature-mobile-reading-surface memo-detail-card px-4 py-5 sm:px-8 sm:py-7" data-testid="public-memo-detail-card">
          <div class="flex flex-wrap items-center gap-3 text-sm text-[color:var(--nature-text-soft)]">
            <span class="nature-chip nature-chip-info gap-1">
              <Icon name="tabler:clock" className="h-3.5 w-3.5" />
              <time dateTime={displayDate} title={formatDateTime(displayDate)}>
                {formatAbsoluteDate(displayDate)}
              </time>
            </span>
            <span class="nature-chip gap-1">
              <Icon name="tabler:bulb" className="h-3.5 w-3.5" />
              Memo
            </span>
          </div>

          <h1 class:list={["nature-title", "mt-5", "text-3xl", "font-semibold", "leading-tight", "tracking-[-0.04em]", "sm:text-4xl", !memo.title && "sr-only"]}>{metadataTitle}</h1>

          {memo.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {memo.tags.map((tag) => (
                <TagBadge tag={tag} iconMap={snapshot.tags.tagIconMap} iconSvgMap={snapshot.tags.tagIconSvgMap} />
              ))}
            </div>
          )}

          <div class="mt-6">
            <MarkdownRenderer
              client:visible={{ rootMargin: "480px" }}
              content={memoDetailContent}
              variant="article"
              enableMath={true}
              enableMermaid={true}
              enableCodeFolding={true}
              removeTags={true}
              rewritePublicSitePaths={true}
              articlePath={memo.filePath}
              contentSource={contentSource}
              publicMediaContext={publicMediaContext}
            />
          </div>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  @media (max-width: 639px) {
    .memo-detail-layout {
      padding-inline: 0;
    }

    .memo-detail-card:is(:hover, :focus-within) {
      transform: none;
      border-color: transparent;
      box-shadow: none;
    }
  }
</style>

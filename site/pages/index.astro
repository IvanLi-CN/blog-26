---
import { SITE } from "@/config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectExternalLinks from "../components/projects/ProjectExternalLinks.astro";
import {
  getFeaturedProjects,
  getProjectCardEntries,
  getProjectDetailPath,
  getProjectDomainDefinition,
} from "../lib/projects";
import { buildHomeTimeline, getSnapshot } from "../lib/public-site";
import { toPublicSitePath } from "../lib/runtime-urls";
import TimelineCard from "../components/TimelineCard.astro";
import Icon from "@/components/ui/Icon";
import FeaturedProjectLogo from "../components/projects/FeaturedProjectLogo.astro";
import codexVibeMonitorLogo from "../assets/projects/logos/codex-vibe-monitor-product-mark.svg";
import spotiBindLogo from "../assets/projects/logos/spotibind-logo-monochrome.svg";
import kaisouMailLogo from "../assets/projects/logos/kaisoumail-brand-symbol.png";
import kaisouMailLogoDark from "../assets/projects/logos/kaisoumail-brand-symbol-on-dark.png";
import tuckmarkLogo from "../assets/projects/logos/tuckmark-mark-square-light.svg";
import tuckmarkLogoDark from "../assets/projects/logos/tuckmark-mark-square-dark.svg";
import xpLogo from "../assets/projects/logos/xp-logo-monochrome.svg";

const snapshot = await getSnapshot();
const timeline = buildHomeTimeline(snapshot);
const assetVersion = snapshot.generatedAt;
const featuredProjects = getFeaturedProjects();
const featuredProjectLogos = {
  "codex-vibe-monitor": {
    src: codexVibeMonitorLogo.src,
    kind: "native" as const,
    label: "Codex Vibe Monitor Logo",
  },
  "spoti-bind": {
    src: spotiBindLogo.src,
    kind: "mask" as const,
    label: "SpotiBind Logo",
    colorLight: "#178243",
    colorDark: "#65d596",
  },
  kaisoumail: {
    src: kaisouMailLogo.src,
    darkSrc: kaisouMailLogoDark.src,
    kind: "native" as const,
    label: "KaisouMail Logo",
  },
  tuckmark: {
    src: tuckmarkLogo.src,
    darkSrc: tuckmarkLogoDark.src,
    kind: "native" as const,
    label: "Tuckmark Logo",
  },
  xp: {
    src: xpLogo.src,
    kind: "mask" as const,
    label: "XP Logo",
    colorLight: "#277d78",
    colorDark: "#89d8be",
  },
} as const;
---
<BaseLayout pathname="/" title={SITE.title} description={SITE.description}>
  <section class="nature-container px-2 py-7 sm:px-6 sm:py-8 md:py-12">
    <div class="nature-surface nature-mobile-structural px-4 py-6 text-center sm:px-8 sm:py-12">
      <span class="nature-kicker mx-auto mb-5">Nature Interface</span>
      <h1 class="nature-title mx-auto max-w-4xl text-4xl font-bold sm:text-5xl md:text-6xl">
        Ivan&apos;s <span class="text-[color:var(--nature-accent-strong)]">Blog</span>，在流动的数字温室里安放想法。
      </h1>
      <p class="nature-muted mx-auto mt-5 max-w-3xl text-base leading-8 sm:text-lg">
        {SITE.description}
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href={toPublicSitePath("/posts")} class="nature-button nature-button-primary">
          <Icon name="tabler:article" className="h-4 w-4" />
          浏览文章
        </a>
        <a href={toPublicSitePath("/memos")} class="nature-button nature-button-outline">
          <Icon name="tabler:bulb" className="h-4 w-4" />
          进入 Memos
        </a>
      </div>
    </div>
  </section>

  <section class="nature-container px-1 py-5 sm:px-6 sm:py-6 md:py-10">
    {timeline.length > 0 ? (
      <div class="nature-timeline" data-testid="home-timeline">
        {timeline.map((item, index) => (
          <TimelineCard
            item={item}
            isLast={index === timeline.length - 1}
            iconMap={snapshot.tags.tagIconMap}
            iconSvgMap={snapshot.tags.tagIconSvgMap}
            assetVersion={assetVersion}
          />
        ))}
      </div>
    ) : (
      <div class="nature-empty">
        <Icon name="tabler:timeline" className="mx-auto mb-2 h-8 w-8 opacity-50" />
        <p>暂无内容</p>
      </div>
    )}
  </section>

  <section class="nature-container px-2 py-5 sm:px-6 sm:py-6 md:py-8">
    <div class="mb-6 flex items-center justify-between gap-4">
      <div>
        <h2 class="nature-title flex items-center gap-3 text-2xl font-semibold sm:text-3xl">
          <Icon name="tabler:code" className="h-6 w-6 text-[color:var(--nature-accent-strong)]" />
          精选项目 ({featuredProjects.length})
        </h2>
      </div>
      <a
        href={toPublicSitePath("/projects")}
        class="nature-button nature-button-ghost featured-projects-all-link"
        aria-label="查看全部项目"
        title="查看全部项目"
      >
        <Icon name="tabler:arrow-up-right" className="h-4 w-4" />
        <span class="featured-projects-all-label">查看全部</span>
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {featuredProjects.map((project) => {
        const logo = featuredProjectLogos[project.slug as keyof typeof featuredProjectLogos];
        return (
          <article
            class="nature-hover-hitbox"
            data-testid="featured-project-card"
            data-project-slug={project.slug}
            data-logo-state={logo ? "available" : "missing"}
          >
            <div class="nature-panel nature-panel-soft nature-hover-lift nature-hover-surface featured-project-panel h-full px-4 py-4 sm:px-5 sm:py-5 [--nature-hover-border-color:rgba(var(--nature-accent-rgb),0.34)] [--nature-hover-lift-offset:-0.14rem] [--nature-hover-shadow:0_20px_40px_rgba(8,21,16,0.14)]">
              {logo && (
                <FeaturedProjectLogo
                  {...logo}
                  variant="watermark"
                />
              )}
              <div class="relative z-[1] flex h-full flex-col gap-4">
                <div class="flex min-h-14 items-center gap-3">
                  {logo && <FeaturedProjectLogo {...logo} variant="inline" />}
                  <div class="min-w-0">
                    <h3 class="font-heading text-2xl font-semibold tracking-[-0.04em] text-[color:var(--nature-text)]">
                      <a
                        href={toPublicSitePath(getProjectDetailPath(project.slug))}
                        class="transition-colors hover:text-[color:var(--nature-accent-strong)]"
                      >
                        {project.title}
                      </a>
                    </h3>
                    <span class="nature-muted mt-1 block text-xs font-medium">
                      {getProjectDomainDefinition(project.domain).title}
                    </span>
                  </div>
                </div>

                <p class="nature-muted min-h-[4.25rem] text-sm leading-7">{project.summary}</p>

                <div class="flex min-h-8 flex-wrap content-start gap-2">
                  {project.techTags.slice(0, 2).map((tag) => (
                    <span class="nature-chip text-xs">{tag}</span>
                  ))}
                </div>

                <div class="featured-project-footer mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-[color:rgba(var(--nature-border-rgb),0.32)] pt-3" data-featured-project-footer>
                  <a
                    href={toPublicSitePath(getProjectDetailPath(project.slug))}
                    class="nature-button nature-button-ghost px-3 py-2 text-sm"
                    data-project-case-link
                  >
                    <Icon name="tabler:arrow-right" className="h-4 w-4" />
                    查看案例
                  </a>
                  <ProjectExternalLinks
                    entries={getProjectCardEntries(project)}
                    compact={true}
                    adaptive={true}
                  />
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .featured-project-panel {
    position: relative;
    isolation: isolate;
    min-height: 18rem;
    overflow: hidden;
  }

  .featured-projects-all-link {
    flex: none;
    white-space: nowrap;
  }

  @media (max-width: 360px) {
    .featured-projects-all-link {
      width: 2.75rem;
      min-width: 2.75rem;
      padding-inline: 0;
    }

    .featured-projects-all-label {
      display: none;
    }
  }
</style>

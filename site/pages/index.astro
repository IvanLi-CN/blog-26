---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicRouter from '../components/PublicRouter';
import {loadPublicRoute} from '../lib/route-data';
import {loadabout} from '../lib/page-data/about';
import {publicRouteMetadata} from '../lib/route-metadata';

const initial = await loadPublicRoute(Astro.request);
if (initial.kind === 'notFound') Astro.response.status = 404;
const metadata = publicRouteMetadata(initial);
const about = { kind: 'about' as const, data: await loadabout(Astro) };
---
<BaseLayout pathname={Astro.url.pathname} {...metadata}>
  <PublicRouter client:load initial={initial} about={about} initialUrl={Astro.url.pathname + Astro.url.search + Astro.url.hash} />
</BaseLayout>

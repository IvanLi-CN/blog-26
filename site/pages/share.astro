---
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemShareConfirmation from "../components/SystemShareConfirmation";

const isConsoleRuntime = process.env.CONSOLE_RUNTIME === "true";
if (!isConsoleRuntime) Astro.response.status = 404;
---

<BaseLayout title="确认分享" description="确认系统分享内容" pathname={Astro.url.pathname}>
  {isConsoleRuntime ? <SystemShareConfirmation client:load /> : <main class="nature-container px-4 py-12">Not Found</main>}
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicRouter from '../components/PublicRouter';
import {loadPublicRoute} from '../lib/route-data';
import {loadabout} from '../lib/page-data/about';
import {publicRouteMetadata} from '../lib/route-metadata';
import SearchBootstrap from '../components/SearchBootstrap.astro';

const initial = await loadPublicRoute(Astro.request);
if (initial.kind === 'notFound') Astro.response.status = 404;
const metadata = publicRouteMetadata(initial);
const about = { kind: 'about' as const, data: await loadabout(Astro) };
---
<BaseLayout pathname={Astro.url.pathname} {...metadata}>
  <PublicRouter client:load initial={initial} about={about} initialUrl={Astro.url.pathname + Astro.url.search + Astro.url.hash}>
    <SearchBootstrap slot="searchBootstrap" />
  </PublicRouter>
  <script is:inline>
    (() => {
      const bootstrap = document.querySelector("[data-search-bootstrap]");
      const islandHost = document.querySelector("[data-search-island]");
      if (!(bootstrap instanceof HTMLElement) || !(islandHost instanceof HTMLElement)) return;
      const island = islandHost.closest("astro-island");
      let hydrationTimeout = 0;
      const reveal = () => {
        window.clearTimeout(hydrationTimeout);
        const current = document.querySelector("[data-search-bootstrap]");
        if (current instanceof HTMLElement) {
          current.hidden = true;
          current.inert = true;
          current.setAttribute("aria-hidden", "true");
        }
        document.documentElement.removeAttribute("data-public-search-bootstrap-active");
      };
      const query = new URL(window.location.href).searchParams.get("q") ?? "";
      if (!query.trim() || !(island instanceof HTMLElement) || island.dataset.searchReady === "true") return;
      const input = bootstrap.querySelector("[data-search-query-input]");
      if (input instanceof HTMLInputElement) {
        input.value = query;
        input.setAttribute("value", query);
      }
      bootstrap.querySelectorAll("[data-search-query-text]").forEach((element) => { element.textContent = query.trim(); });
      bootstrap.hidden = false;
      bootstrap.inert = false;
      bootstrap.removeAttribute("aria-hidden");
      document.documentElement.setAttribute("data-public-search-bootstrap-active", "");
      // Astro transports named slots during hydration. Each committed search
      // render must hide the current slot node, including a route-key remount.
      island.addEventListener("public-search:ready", reveal);
      const showError = () => {
        bootstrap.firstElementChild?.removeAttribute("aria-busy");
        const loading = bootstrap.querySelector("[data-search-results-region]");
        const error = bootstrap.querySelector("[data-search-bootstrap-error]");
        if (loading instanceof HTMLElement) loading.hidden = true;
        if (error instanceof HTMLElement) error.hidden = false;
      };
      island.addEventListener("public-search:error", showError, { once: true });
      bootstrap.querySelector("[data-search-bootstrap-reload]")?.addEventListener("click", () => window.location.reload());
      hydrationTimeout = window.setTimeout(showError, 10_000);
    })();
  </script>
</BaseLayout>

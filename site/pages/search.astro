---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchPageIsland from "../components/SearchPageIsland";
import PublicSearchPage from "../../src/components/search/PublicSearchPage";

const bootstrapQuery = "__SEARCH_QUERY__";
---
<BaseLayout pathname="/search" title="搜索 - Ivan's Blog" description="搜索文章与公开 Memos">
  <div data-search-bootstrap hidden inert aria-hidden="true">
    <PublicSearchPage
      query={bootstrapQuery}
      searchedQuery={bootstrapQuery}
      results={[]}
      isLoading
      filter="all"
      inputId="public-search-bootstrap-input"
      isBootstrap
      onFilterChange={() => undefined}
      onQueryChange={() => undefined}
      onSubmit={() => undefined}
    />
    <section
      data-search-bootstrap-error
      hidden
      class="nature-container pb-10 pt-3 sm:pb-14 sm:pt-4"
    >
      <article
        role="alert"
        class="nature-panel nature-panel-soft relative overflow-hidden px-5 py-5 sm:px-6 sm:py-6"
      >
        <div class="relative max-w-[64ch]">
          <span class="nature-kicker inline-flex px-3 py-1 text-xs">搜索中断</span>
          <h2 class="mt-3 font-heading text-2xl font-semibold leading-tight text-[color:var(--nature-text)] sm:text-3xl">
            搜索组件暂时没有加载完成
          </h2>
          <p class="mt-3 text-sm leading-7 text-[color:var(--nature-text-soft)] sm:text-base">
            关键词「<span data-search-query-text>{bootstrapQuery}</span>」仍已保留，请刷新页面重试。
          </p>
          <button
            type="button"
            data-search-bootstrap-reload
            class="mt-5 inline-flex min-h-11 items-center justify-center rounded-full border border-[rgba(var(--nature-accent-rgb),0.28)] bg-[rgba(var(--nature-accent-rgb),0.1)] px-4 text-sm font-medium text-[color:var(--nature-accent-strong)] transition hover:-translate-y-0.5 hover:border-[rgba(var(--nature-accent-rgb),0.46)] hover:bg-[rgba(var(--nature-accent-rgb),0.16)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(var(--nature-accent-rgb),0.42)]"
          >
            刷新重试
          </button>
        </div>
      </article>
    </section>
  </div>
  <div data-search-island>
    <SearchPageIsland client:load />
  </div>

  <script is:inline data-astro-rerun>
    (() => {
      const bootstrap = document.querySelector("[data-search-bootstrap]");
      const islandHost = document.querySelector("[data-search-island]");
      if (!(bootstrap instanceof HTMLElement) || !(islandHost instanceof HTMLElement)) return;

      const revealIsland = () => {
        window.clearTimeout(hydrationTimeout);
        bootstrap.hidden = true;
        bootstrap.inert = true;
        bootstrap.setAttribute("aria-hidden", "true");
        islandHost.hidden = false;
        islandHost.inert = false;
        islandHost.removeAttribute("aria-hidden");
      };

      let hydrationTimeout = 0;

      const query = new URL(window.location.href).searchParams.get("q") ?? "";
      const normalizedQuery = query.trim();
      if (!normalizedQuery) {
        revealIsland();
        return;
      }

      const input = bootstrap.querySelector("[data-search-query-input]");
      if (input instanceof HTMLInputElement) input.value = query;
      bootstrap.querySelectorAll("[data-search-query-text]").forEach((element) => {
        element.textContent = normalizedQuery;
      });

      bootstrap.hidden = false;
      bootstrap.inert = false;
      bootstrap.removeAttribute("aria-hidden");
      islandHost.hidden = true;
      islandHost.inert = true;
      islandHost.setAttribute("aria-hidden", "true");

      const island = islandHost.querySelector("astro-island");
      if (!(island instanceof HTMLElement) || !island.hasAttribute("ssr")) {
        revealIsland();
        return;
      }
      if (island.dataset.searchReady === "true") {
        revealIsland();
        return;
      }
      island.addEventListener("public-search:ready", revealIsland, { once: true });
      const showHydrationError = () => {
        window.clearTimeout(hydrationTimeout);
        const searchRoot = bootstrap.firstElementChild;
        if (searchRoot instanceof HTMLElement) searchRoot.removeAttribute("aria-busy");
        const loadingRegion = bootstrap.querySelector("[data-search-results-region]");
        if (loadingRegion instanceof HTMLElement) loadingRegion.hidden = true;
        const errorRegion = bootstrap.querySelector("[data-search-bootstrap-error]");
        if (errorRegion instanceof HTMLElement) errorRegion.hidden = false;
      };
      island.addEventListener("public-search:error", showHydrationError, { once: true });
      bootstrap
        .querySelector("[data-search-bootstrap-reload]")
        ?.addEventListener("click", () => window.location.reload(), { once: true });
      hydrationTimeout = window.setTimeout(showHydrationError, 10_000);
    })();
  </script>
</BaseLayout>

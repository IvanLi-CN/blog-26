---
import ThemeToggle from "@/components/common/ThemeToggle";
import { footerData, headerData } from "@/config/navigation";
import { SITE } from "@/config/site";
import { toPublicSitePath } from "../lib/runtime-urls";
import SiteHeader from "../components/SiteHeader";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "知识对话", description = "站内知识问答" } = Astro.props;
const homePath = toPublicSitePath("/") ?? "/";
const searchPath = toPublicSitePath("/search") ?? "/search";
const markPath = toPublicSitePath("/site-assets/ivan-blog-mark.svg") ?? "/site-assets/ivan-blog-mark.svg";
const footerUtilityLinks = footerData.socialLinks.filter((social) => social.href === "/feed.xml");
const currentYear = new Date().getFullYear();
---

<BaseLayout pathname={Astro.url.pathname} title={title} description={description}>
  <div class="assistant-route-layout" data-testid="assistant-route-layout">
    <header class="assistant-route-header" data-testid="assistant-route-header">
      <div class="assistant-route-header-inner">
        <a class="assistant-route-brand" href={homePath} aria-label="返回 Ivan's Blog 首页">
          <span
            class="assistant-route-brand-mark"
            aria-hidden="true"
            style={`--assistant-route-mark-url: url("${markPath}")`}
          ></span>
          <span class="assistant-route-brand-copy">
            <span class="assistant-route-brand-name">Ivan's Blog</span>
            <span class="assistant-route-brand-divider" aria-hidden="true">/</span>
            <span class="assistant-route-brand-title">知识对话</span>
          </span>
        </a>

        <nav class="assistant-route-nav" aria-label="站点导航">
          <a href={homePath}>首页</a>
          {headerData.links.map((link) => (
            <a href={toPublicSitePath(link.href) ?? link.href}>{link.text}</a>
          ))}
          <a href={searchPath}>搜索</a>
        </nav>

        <div class="assistant-route-header-tools">
          <ThemeToggle client:load compact iconClass="h-4 w-4" />
        </div>
      </div>
    </header>

    <SiteHeader
      client:load
      className="assistant-route-mobile-header"
      enableScrollBehavior
      pathname={Astro.url.pathname}
      contextLabel="知识对话"
      showRss={false}
      showSearch={false}
      testId="assistant-route-mobile-header"
    />

    <div class="assistant-route-content">
      <slot />
    </div>

    <footer class="assistant-route-footer" data-testid="assistant-route-footer">
      <div class="assistant-route-footer-inner">
        <div class="assistant-route-footer-line">
          <span class="assistant-route-footer-title">{SITE.name}</span>
          <span class="assistant-route-footer-meta">
            <span>© {currentYear} {SITE.owner} · Code: MIT</span>
            <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" target="_blank" rel="noopener noreferrer">
              Content: CC BY-NC-ND 4.0
            </a>
          </span>
          <span class="assistant-route-footer-utilities">
            {footerUtilityLinks.map((social) => (
              <a
                href={social.href.startsWith("/") ? toPublicSitePath(social.href) : social.href}
                target={social.href.startsWith("/") ? undefined : "_blank"}
                rel={social.href.startsWith("/") ? undefined : "noopener noreferrer"}
              >
                {social.ariaLabel}
              </a>
            ))}
            <a class="assistant-route-footer-record" target="_blank" rel="noopener noreferrer" href="https://beian.miit.gov.cn">
              闽ICP备2023000043号
            </a>
          </span>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .assistant-route-layout {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  :global(.assistant-route-mobile-header) {
    display: none;
  }

  .assistant-route-header {
    position: sticky;
    top: 0;
    z-index: 30;
    flex: 0 0 auto;
    padding: 0.55rem max(1rem, 3vw) 0;
  }

  .assistant-route-header-inner {
    display: grid;
    width: min(92rem, 100%);
    min-height: 3.5rem;
    align-items: center;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.8rem;
    margin: 0 auto;
    border-bottom: 1px solid var(--nature-line);
    padding: 0.35rem 0.15rem 0.55rem;
  }

  .assistant-route-brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
    color: var(--nature-text);
  }

  .assistant-route-brand-mark {
    display: block;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    background-color: var(--nature-accent-strong);
    -webkit-mask: var(--assistant-route-mark-url) center / contain no-repeat;
    mask: var(--assistant-route-mark-url) center / contain no-repeat;
  }

  .assistant-route-brand-copy {
    display: inline-flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.45rem;
    white-space: nowrap;
  }

  .assistant-route-brand-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .assistant-route-brand-divider,
  .assistant-route-footer-divider {
    color: var(--nature-text-faint);
  }

  .assistant-route-brand-title {
    color: var(--nature-text-soft);
    font-size: 0.85rem;
  }

  .assistant-route-nav {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .assistant-route-nav::-webkit-scrollbar {
    display: none;
  }

  .assistant-route-header-tools {
    display: flex;
    align-items: center;
  }

  .assistant-route-nav > a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: 999px;
    color: var(--nature-text-soft);
    padding: 0.45rem 0.7rem;
    font-size: 0.8rem;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .assistant-route-nav > a:hover,
  .assistant-route-nav > a:focus-visible {
    background: color-mix(in srgb, var(--nature-accent) 10%, transparent);
    color: var(--nature-accent-strong);
  }

  .assistant-route-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
  }

  .assistant-route-footer {
    flex: 0 0 auto;
    padding: 0.9rem max(1rem, 3vw) 1.25rem;
  }

  .assistant-route-footer-inner {
    width: min(92rem, 100%);
    margin: 0 auto;
    border-top: 1px solid var(--nature-line);
    color: var(--nature-text-faint);
    padding: 0.55rem 0.15rem 0;
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .assistant-route-footer-line {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.2rem 0.65rem;
  }

  .assistant-route-footer-title {
    color: var(--nature-text-soft);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .assistant-route-footer-meta,
  .assistant-route-footer-utilities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.65rem;
  }

  .assistant-route-footer-meta {
    justify-content: center;
  }

  .assistant-route-footer-utilities {
    justify-content: flex-end;
  }

  .assistant-route-footer-line a,
  .assistant-route-footer-record {
    color: var(--nature-text-soft);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .assistant-route-footer-record {
    display: inline;
  }

  @media (max-width: 639px) {
    :global(.assistant-route-mobile-header) {
      display: block;
    }

    .assistant-route-header {
      display: none;
      padding-top: 0.35rem;
    }

    .assistant-route-header-inner {
      display: flex;
      flex-wrap: wrap;
      min-height: 3rem;
      gap: 0.5rem;
      padding-bottom: 0.4rem;
    }

    .assistant-route-brand-mark {
      width: 1.75rem;
      height: 1.75rem;
    }

    .assistant-route-brand-copy {
      gap: 0.3rem;
    }

    .assistant-route-brand-name {
      font-size: 0.85rem;
    }

    .assistant-route-brand-title {
      font-size: 0.78rem;
    }

    .assistant-route-nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      border-top: 1px solid var(--nature-line);
      padding-top: 0.35rem;
    }

    .assistant-route-nav > a {
      padding-inline: 0.45rem;
      font-size: 0.72rem;
    }

    .assistant-route-header-tools {
      margin-left: auto;
    }

    .assistant-route-footer-line {
      grid-template-columns: 1fr;
      gap: 0.2rem 0.55rem;
    }

    .assistant-route-footer-meta,
    .assistant-route-footer-utilities {
      justify-content: flex-start;
    }

  }
</style>

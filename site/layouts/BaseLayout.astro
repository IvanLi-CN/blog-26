---
import "@/lib/iconify-collections";
import "../../src/styles/globals.css";
import "../../src/styles/nature-restored.css";
import AmbientScene from "@/components/common/AmbientScene";
import WebDemoInspector from "@/components/WebDemoInspector";
import { SITE, UI } from "@/config/site";
import IconifyBoot from "../components/IconifyBoot";
import { getPublicPwaAssetPaths } from "../lib/public-pwa";
import { getCanonicalUrl, toAbsoluteSiteUrl } from "../lib/public-site";
import { toPublicSitePath } from "../lib/runtime-urls";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  image?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  pathname = "/",
  image = SITE.images.default,
} = Astro.props;
const canonical = getCanonicalUrl(pathname);
const isConsoleRuntime = process.env.CONSOLE_RUNTIME === "true";
const isWebDemoBuild = process.env.WEB_DEMO_BUILD === "true";
const pwaAssets = await getPublicPwaAssetPaths();
const resolvedImage =
  image.startsWith("http") || image.startsWith("data:")
    ? image
    : toAbsoluteSiteUrl(toPublicSitePath(image) ?? image);
---
<html
  lang="zh-CN"
  data-web-demo-build={isWebDemoBuild ? "true" : undefined}
  data-ui-theme="light"
  data-ui-preference="system"
  data-theme="light"
  data-public-session-id=""
  style={{ colorScheme: "light" }}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isConsoleRuntime && <meta name="robots" content="noindex, nofollow" />}
    <meta name="keywords" content={SITE.keywords.join(",")} />
    <meta name="generator" content="Astro" />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href={toPublicSitePath("/site.webmanifest")} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" media="(prefers-color-scheme: light)" href={toPublicSitePath(pwaAssets.faviconIco)} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" media="(prefers-color-scheme: dark)" href={toPublicSitePath(pwaAssets.faviconDarkIco)} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={toPublicSitePath(pwaAssets.faviconSvg)} />
    <link rel="apple-touch-icon" sizes="180x180" href={toPublicSitePath(pwaAssets.appleTouch180)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS Feed`}
      href={toPublicSitePath("/feed.xml")}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={`${SITE.title} Atom Feed`}
      href={toPublicSitePath("/atom.xml")}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={`${SITE.title} JSON Feed`}
      href={toPublicSitePath("/feed.json")}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.seo.openGraph.locale} />
    <meta property="og:site_name" content={SITE.seo.openGraph.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedImage} />
    <meta name="twitter:card" content={SITE.seo.twitter.card} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:creator" content={SITE.seo.twitter.creator} />
    <meta name="twitter:site" content={SITE.seo.twitter.site} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#edf4ef" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;700&display=swap" rel="stylesheet" />
    <script
      define:vars={{
        defaultTheme: UI.theme.default,
        legacyLightThemes: UI.theme.legacyLight,
        legacyDarkThemes: UI.theme.legacyDark,
        webDemoBuild: isWebDemoBuild,
      }}
    >
      (() => {
        const SESSION_KEY = "__astroPublicNavigationSessionId";

        function normalizeTheme(theme) {
          if (theme === "dark" || legacyDarkThemes.includes(theme)) return "dark";
          if (theme === "light" || legacyLightThemes.includes(theme)) return "light";
          return "system";
        }

        const colorSchemePreference = window.matchMedia("(prefers-color-scheme: dark)");

        function resolveTheme(theme) {
          const normalizedTheme = normalizeTheme(theme);
          if (normalizedTheme === "dark") return "dark";
          if (normalizedTheme === "light") return "light";
          return colorSchemePreference.matches ? "dark" : "light";
        }

        function getStoredTheme() {
          if (webDemoBuild) {
            const urlThemeValue = new URLSearchParams(window.location.search).get("d_theme");
            const urlTheme = normalizeTheme(urlThemeValue);
            if (urlThemeValue && ["light", "dark", "system"].includes(urlThemeValue)) {
              localStorage.setItem("theme", urlTheme);
              return urlTheme;
            }
            try {
              const session = JSON.parse(
                sessionStorage.getItem("web-demo-global-environment") || "null"
              );
              if (session && ["light", "dark", "system"].includes(session.theme)) {
                localStorage.setItem("theme", session.theme);
                return session.theme;
              }
            } catch {
              // Ignore malformed session state and keep the product preference.
            }
          }
          return localStorage.getItem("theme") || defaultTheme;
        }

        function getDemoMotionPreference() {
          if (!webDemoBuild) return;
          const urlMotion = new URLSearchParams(window.location.search).get("d_motion");
          if (urlMotion === "system" || urlMotion === "reduce") return urlMotion;
          try {
            const session = JSON.parse(
              sessionStorage.getItem("web-demo-global-environment") || "null"
            );
            if (session?.motion === "system" || session?.motion === "reduce") return session.motion;
          } catch {
            // Ignore malformed session state and keep the system preference.
          }
          return "system";
        }

        function syncThemeColor(doc = document) {
          const themeColor = doc.querySelector('meta[name="theme-color"]');
          const backgroundColor = getComputedStyle(doc.documentElement)
            .getPropertyValue("--nature-bg")
            .trim();
          if (themeColor && backgroundColor) themeColor.setAttribute("content", backgroundColor);
        }

        function ensureNavigationSession(doc = document) {
          if (!window[SESSION_KEY]) {
            window[SESSION_KEY] =
              typeof crypto?.randomUUID === "function"
                ? crypto.randomUUID()
                : `astro-session-${Math.random().toString(36).slice(2, 10)}`;
          }

          doc.documentElement.dataset.publicSessionId = window[SESSION_KEY];
        }

        function applyTheme(theme, doc = document) {
          const d = doc.documentElement;
          const normalizedTheme = normalizeTheme(theme);
          const resolvedTheme = resolveTheme(normalizedTheme);
          d.setAttribute("data-ui-theme", resolvedTheme);
          d.setAttribute("data-ui-preference", normalizedTheme);
          d.setAttribute("data-theme", resolvedTheme);
          d.classList.toggle("dark", resolvedTheme === "dark");
          d.style.colorScheme = resolvedTheme;
          syncThemeColor(doc);
          window.requestAnimationFrame(() => syncThemeColor(doc));

          if (theme !== normalizedTheme) {
            localStorage.setItem("theme", normalizedTheme);
          }
        }

        function syncDocumentState(doc = document) {
          applyTheme(getStoredTheme(), doc);
          ensureNavigationSession(doc);
          const motion = getDemoMotionPreference();
          if (motion) doc.documentElement.dataset.webDemoMotion = motion;
        }

        colorSchemePreference.addEventListener("change", () => {
          if (normalizeTheme(getStoredTheme()) === "system") applyTheme("system");
        });

        document.addEventListener("astro:before-swap", (event) => {
          syncDocumentState(event.newDocument);
        });
        document.addEventListener("astro:after-swap", () => {
          syncDocumentState();
        });
        document.addEventListener("astro:page-load", () => {
          syncDocumentState();
        });
        document.addEventListener("DOMContentLoaded", () => syncThemeColor(), { once: true });

        syncDocumentState();
      })();
    </script>
    <script>
      import "@/lib/public-scrollbar";
      import "@/lib/public-header-scroll";
      import "@/lib/public-reading-viewport";
    </script>
  </head>
  <body>
    <IconifyBoot client:load />
    <div class="nature-app-shell flex min-h-screen flex-col" data-testid="public-site-shell">
      <AmbientScene client:load />
      <div class="nature-content-layer flex min-h-screen flex-col">
        <slot />
      </div>
    </div>
    {isWebDemoBuild ? (
      <WebDemoInspector client:load app="public" initialPathname={Astro.url.pathname} />
    ) : null}
  </body>
</html>

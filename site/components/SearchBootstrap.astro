---
import PublicSearchPage from "@/components/search/PublicSearchPage";
const bootstrapQuery = "__SEARCH_QUERY__";
---
<div data-search-bootstrap hidden inert aria-hidden="true">
  <PublicSearchPage
    query={bootstrapQuery}
    searchedQuery={bootstrapQuery}
    results={[]}
    isLoading
    filter="all"
    inputId="public-search-bootstrap-input"
    isBootstrap
    onFilterChange={() => undefined}
    onQueryChange={() => undefined}
    onSubmit={() => undefined}
  />
  <section data-search-bootstrap-error hidden class="nature-container pb-10 pt-3 sm:pb-14 sm:pt-4">
    <article role="alert" class="nature-panel nature-panel-soft relative overflow-hidden px-5 py-5 sm:px-6 sm:py-6">
      <div class="relative max-w-[64ch]">
        <span class="nature-kicker inline-flex px-3 py-1 text-xs">搜索中断</span>
        <h2 class="mt-3 font-heading text-2xl font-semibold leading-tight text-[color:var(--nature-text)] sm:text-3xl">搜索组件暂时没有加载完成</h2>
        <p class="mt-3 text-sm leading-7 text-[color:var(--nature-text-soft)] sm:text-base">关键词「<span data-search-query-text>{bootstrapQuery}</span>」仍已保留，请刷新页面重试。</p>
        <button type="button" data-search-bootstrap-reload class="nature-button nature-button-outline mt-5">刷新重试</button>
      </div>
    </article>
  </section>
</div>
<style is:global>
  html[data-public-search-bootstrap-active] [data-search-island] { display: none; }
</style>

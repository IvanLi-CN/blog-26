---
import Icon from "@/components/ui/Icon";
import { MemoTypeBadge } from "@/components/memos/MemoTypeBadge";
import { getMemoPresentation } from "@/lib/memo-presentation";
import type { PublicMemoRecord } from "@/public-site/snapshot";
import TagBadge from "./TagBadge.astro";
import { formatAbsoluteDate, formatDateTime } from "../lib/format";

interface Props {
  memo: PublicMemoRecord;
  metadataTitle: string;
  displayDate: string;
  tagIconMap?: Record<string, string | null>;
  tagIconSvgMap?: Record<string, string | null>;
}

const { memo, metadataTitle, displayDate, tagIconMap, tagIconSvgMap } = Astro.props;
const presentation = getMemoPresentation(memo);
---
<header data-testid="public-memo-detail-heading">
  <div class="flex flex-wrap items-center gap-3 text-sm text-[color:var(--nature-text-soft)]">
    <span class="nature-chip nature-chip-info gap-1">
      <Icon name="tabler:clock" className="h-3.5 w-3.5" />
      <time dateTime={displayDate} title={formatDateTime(displayDate)}>{formatAbsoluteDate(displayDate)}</time>
    </span>
    <MemoTypeBadge record={memo} />
  </div>
  <h1 class:list={["nature-title mt-5 text-3xl font-semibold leading-tight tracking-[-0.04em] sm:text-4xl", !memo.title && "sr-only"]}>{metadataTitle}</h1>
  {presentation.tags.length > 0 && (
    <div class="mt-5 flex flex-wrap gap-2">
      {presentation.tags.map((tag) => <TagBadge tag={tag} iconMap={tagIconMap} iconSvgMap={tagIconSvgMap} />)}
    </div>
  )}
</header>

---
import type { RuntimeActivityPoint } from "../../lib/project-runtime-metrics";

interface Props {
  points: RuntimeActivityPoint[];
  label: string;
  kind: "tokens" | "requests";
}

const { points, label, kind } = Astro.props as Props;
const maxValue = Math.max(...points.map((point) => point.value), 1);
const valueLabel = kind === "tokens" ? "Token" : "请求";
const numberFormatter = new Intl.NumberFormat("zh-CN");
const dayMilliseconds = 24 * 60 * 60 * 1000;
const parseDate = (date: string) => {
  const [year, month, day] = date.split("-").map(Number);
  return Date.UTC(year, month - 1, day);
};
const formatDate = (timestamp: number) => new Date(timestamp).toISOString().slice(0, 10);
const firstTimestamp = parseDate(points[0]?.date ?? "1970-01-01");
const lastTimestamp = parseDate(points.at(-1)?.date ?? points[0]?.date ?? "1970-01-01");
const calendarStart = firstTimestamp - new Date(firstTimestamp).getUTCDay() * dayMilliseconds;
const calendarEnd = lastTimestamp + (6 - new Date(lastTimestamp).getUTCDay()) * dayMilliseconds;
const weekCount = Math.floor((calendarEnd - calendarStart) / (7 * dayMilliseconds)) + 1;
const pointsByDate = new Map(points.map((point) => [point.date, point]));
const calendarCells = Array.from({ length: weekCount * 7 }, (_, index) => {
  const timestamp = calendarStart + index * dayMilliseconds;
  const date = formatDate(timestamp);
  return {
    date,
    point: pointsByDate.get(date),
    week: Math.floor(index / 7) + 1,
    weekday: (index % 7) + 1,
  };
});
---
<section class="runtime-activity" data-runtime-chart aria-label={label}>
  <h3 class="runtime-chart-title">{label}</h3>
  <div
    class="runtime-activity-grid"
    role="list"
    data-week-count={weekCount}
    data-weekday-count="7"
    style={`--runtime-week-count:${weekCount}`}
  >
    {calendarCells.map((cell) =>
      cell.point ? (
        <span
          class="runtime-activity-cell"
          data-runtime-point
          data-date={cell.point.date}
          data-value={numberFormatter.format(cell.point.value)}
          data-label={valueLabel}
          style={`--runtime-week:${cell.week};--runtime-weekday:${cell.weekday};--runtime-intensity:${Math.min(cell.point.value / maxValue, 1)}`}
          role="img"
          tabindex="0"
          aria-label={`${cell.point.date} ${valueLabel} ${numberFormatter.format(cell.point.value)}`}
        ></span>
      ) : (
        <span
          class="runtime-activity-slot runtime-activity-slot--empty"
          style={`--runtime-week:${cell.week};--runtime-weekday:${cell.weekday}`}
          aria-hidden="true"
        ></span>
      )
    )}
  </div>
  <div class="runtime-chart-tooltip" data-runtime-tooltip role="status" aria-live="polite" hidden></div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-runtime-chart]").forEach((chart) => {
      if (chart.dataset.runtimeBound === "true") return;
      chart.dataset.runtimeBound = "true";
      const tooltip = chart.querySelector("[data-runtime-tooltip]");
      if (!tooltip) return;

      const hideTooltip = () => {
        tooltip.hidden = true;
        tooltip.textContent = "";
      };
      const showTooltip = (point) => {
        tooltip.textContent = `${point.dataset.date} · ${point.dataset.label}: ${point.dataset.value}`;
        tooltip.hidden = false;
      };

      chart.querySelectorAll("[data-runtime-point]").forEach((point) => {
        point.addEventListener("pointerenter", () => showTooltip(point));
        point.addEventListener("pointerleave", hideTooltip);
        point.addEventListener("focus", () => showTooltip(point));
        point.addEventListener("blur", hideTooltip);
        point.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          if (tooltip.hidden) showTooltip(point);
          else hideTooltip();
        });
        point.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            event.stopPropagation();
            showTooltip(point);
          }
          if (event.key === "Escape") hideTooltip();
        });
      });
    });
  })();
</script>

<style>
  .runtime-activity {
    position: relative;
    grid-row: 2;
    z-index: 1;
    display: grid;
    align-content: end;
    gap: 0.55rem;
    min-height: 0;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(var(--nature-highlight-rgb), 0.14);
  }

  .runtime-chart-title {
    margin: 0;
    color: var(--runtime-text-soft);
    font-size: 0.71rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .runtime-activity-grid {
    display: grid;
    grid-template-columns: repeat(var(--runtime-week-count), minmax(0, 1fr));
    grid-template-rows: repeat(7, minmax(0, 1fr));
    gap: 0.18rem;
    min-height: 8.6rem;
    padding: 0.08rem 0;
  }

  .runtime-activity-slot {
    display: block;
    grid-column: var(--runtime-week);
    grid-row: var(--runtime-weekday);
    min-width: 0;
    min-height: 0.42rem;
    border-radius: 0.13rem;
  }

  .runtime-activity-cell {
    outline: none;
    background: rgba(var(--runtime-accent-rgb), calc(0.12 + var(--runtime-intensity) * 0.78));
    box-shadow: inset 0 0 0 1px rgba(var(--nature-highlight-rgb), 0.04);
    cursor: help;
  }

  .runtime-activity-slot--empty {
    background: transparent;
    box-shadow: none;
    cursor: default;
    pointer-events: none;
  }

  .runtime-activity-cell[data-value="0"] {
    background: rgba(var(--nature-highlight-rgb), 0.08);
  }

  .runtime-activity-cell:hover,
  .runtime-activity-cell:focus-visible {
    z-index: 1;
    outline: 2px solid rgba(var(--nature-highlight-rgb), 0.9);
    outline-offset: 1px;
    background: rgba(var(--runtime-warm-rgb), 0.92);
  }

  .runtime-chart-tooltip {
    min-height: 1.15rem;
    overflow: hidden;
    color: var(--runtime-text-soft);
    font-size: 0.66rem;
    line-height: 1.2;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .runtime-chart-tooltip[hidden] {
    visibility: hidden;
  }

  @media (max-width: 767px) {
    .runtime-activity-grid {
      min-height: 9rem;
    }
  }
</style>

---
import type { ImageMetadata } from "astro";
import codexVibeMonitorMark from "../../assets/projects/logos/codex-vibe-monitor-product-mark.svg";
import tavilyHikariLight from "../../assets/projects/logos/tavily-hikari-lockup-light.svg";
import tavilyHikariDark from "../../assets/projects/logos/tavily-hikari-lockup-dark.svg";
import octoRillLight from "../../assets/projects/logos/octo-rill-wordmark-light.svg";
import octoRillDark from "../../assets/projects/logos/octo-rill-wordmark-dark.svg";

type PanelKind = "codex-vibe-monitor" | "tavily-hikari" | "octo-rill";

interface Props {
  kind: PanelKind;
}

interface LogoPair {
  label: string;
  light: ImageMetadata;
  dark: ImageMetadata;
}

const logos: Record<Exclude<PanelKind, "codex-vibe-monitor">, LogoPair> = {
  "tavily-hikari": {
    label: "Tavily Hikari Logo",
    light: tavilyHikariLight,
    dark: tavilyHikariDark,
  },
  "octo-rill": {
    label: "OctoRill Logo",
    light: octoRillLight,
    dark: octoRillDark,
  },
};

const { kind } = Astro.props as Props;
const logo = kind === "codex-vibe-monitor" ? null : logos[kind];
---

<div
  class:list={[
    "runtime-project-logo",
    `runtime-project-logo--${kind}`,
    { "runtime-project-logo-has-dark": kind !== "codex-vibe-monitor" },
  ]}
  data-runtime-project-logo
  role="img"
  aria-label={kind === "codex-vibe-monitor" ? "Codex Vibe Monitor Logo" : logo.label}
>
  {kind === "codex-vibe-monitor" ? (
    <span class="runtime-project-logo-lockup">
      <img class="runtime-project-logo-mark" src={codexVibeMonitorMark.src} alt="" />
      <span class="runtime-project-logo-name">
        Codex <span>Vibe</span> Monitor
      </span>
    </span>
  ) : (
    <>
      <img class="runtime-project-logo-image runtime-project-logo-image--light" src={logo.light.src} alt="" />
      <img class="runtime-project-logo-image runtime-project-logo-image--dark" src={logo.dark.src} alt="" />
    </>
  )}
</div>

<style>
  .runtime-project-logo {
    display: flex;
    grid-row: 1;
    align-items: center;
    justify-content: flex-start;
    width: min(100%, 12rem);
    min-width: 0;
    min-height: 2.6rem;
    color: var(--runtime-text);
  }

  .runtime-project-logo--codex-vibe-monitor {
    width: min(100%, 18rem);
  }

  .runtime-project-logo-lockup {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    height: 2.6rem;
  }

  .runtime-project-logo-mark {
    display: block;
    flex: 0 0 auto;
    width: 2.1rem;
    height: 2.1rem;
    object-fit: contain;
  }

  .runtime-project-logo-name {
    min-width: 0;
    overflow: hidden;
    color: var(--runtime-text);
    font-family: var(--font-display), "Noto Serif SC", serif;
    font-size: clamp(0.84rem, 2vw, 1.1rem);
    font-weight: 700;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .runtime-project-logo-name span {
    color: rgb(var(--runtime-secondary-rgb));
  }

  .runtime-project-logo-image {
    display: block;
    width: 100%;
    height: 2.6rem;
    object-fit: contain;
    object-position: left center;
  }

  .runtime-project-logo-image--dark {
    display: none;
  }

  :global(html[data-ui-theme="dark"]) .runtime-project-logo-has-dark .runtime-project-logo-image--light {
    display: none;
  }

  :global(html[data-ui-theme="dark"]) .runtime-project-logo-has-dark .runtime-project-logo-image--dark {
    display: block;
  }

  @media (max-width: 690px) {
    .runtime-project-logo {
      width: min(100%, 10.5rem);
    }

    .runtime-project-logo--codex-vibe-monitor {
      width: min(100%, 12rem);
    }

    .runtime-project-logo-image {
      height: 2.35rem;
    }

    .runtime-project-logo-lockup {
      height: 2.35rem;
    }

    .runtime-project-logo-mark {
      width: 1.85rem;
      height: 1.85rem;
    }
  }
</style>

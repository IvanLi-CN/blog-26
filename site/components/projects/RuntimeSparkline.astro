---
import type { RuntimeStat } from "../../lib/project-runtime-metrics";
import "uplot/dist/uPlot.min.css";

interface Props {
  label: string;
  stat: RuntimeStat;
  tone?: "accent" | "secondary" | "warm";
  variant?: "line" | "bars";
  placement?: "full" | "right";
}

const { label, stat, tone = "accent", variant = "line", placement = "full" } = Astro.props as Props;
const trendData = JSON.stringify(stat.trend);
const futurePointCount = stat.trend.points.filter((point) => point.value === null).length;
---
<div
  class={`runtime-sparkline runtime-sparkline--${tone} runtime-sparkline--${variant}`}
  data-runtime-sparkline
  data-runtime-trend={trendData}
  data-runtime-range={stat.trend.range}
  data-runtime-point-count={stat.trend.points.length}
  data-runtime-future-count={futurePointCount}
  data-runtime-chart-variant={variant}
  data-runtime-chart-placement={placement}
  role="img"
  aria-label={`${label}${variant === "bars" ? "柱状趋势图" : "趋势图"}，${stat.trend.range === "today" ? "今日" : "最近几小时"}`}
></div>

<script>
  import uPlot from "uplot";

  interface TrendPoint {
    timestamp: string;
    value: number | null;
  }

  interface TrendData {
    points: TrendPoint[];
  }

  const getColor = (element: HTMLElement) => {
    const styles = getComputedStyle(element);
    if (element.classList.contains("runtime-sparkline--secondary")) {
      return styles.getPropertyValue("--runtime-secondary").trim();
    }
    if (element.classList.contains("runtime-sparkline--warm")) {
      return styles.getPropertyValue("--runtime-warm").trim();
    }
    return styles.getPropertyValue("--runtime-accent").trim();
  };

  const bindSparklines = () => {
    document.querySelectorAll<HTMLElement>("[data-runtime-sparkline]").forEach((element) => {
      if (element.dataset.runtimeSparklineBound === "true") return;
      const trend = JSON.parse(element.dataset.runtimeTrend ?? "{}") as TrendData;
      if (!trend.points?.length) return;

      const xValues = trend.points.map((point) => Math.floor(Date.parse(point.timestamp) / 1000));
      const yValues = trend.points.map((point) => point.value);
      const numericYValues = yValues.filter((value): value is number => value !== null);
      const minY = Math.min(...numericYValues);
      const maxY = Math.max(...numericYValues);
      const variant = element.dataset.runtimeChartVariant === "bars" ? "bars" : "line";
      const placement = element.dataset.runtimeChartPlacement === "right" ? "right" : "full";
      const rangeSpan = Math.max(maxY - minY, Math.abs(maxY) * 0.08, 1);
      const rangePadding = rangeSpan * 0.2;
      const isFlatZero = minY === 0 && maxY === 0;
      const yMin = variant === "bars" ? 0 : isFlatZero ? -1 : Math.max(0, minY - rangePadding);
      const yMax = isFlatZero ? 1 : variant === "bars" ? maxY * 1.14 : maxY + rangePadding;
      const color = getColor(element) || "currentColor";
      const getSize = () => ({
        width: Math.max(Math.floor(element.getBoundingClientRect().width), 8),
        height: Math.max(Math.floor(element.getBoundingClientRect().height), 24),
      });
      const getChartPadding = () => {
        const size = getSize();
        return variant === "bars"
          ? ([48, 0, 8, Math.floor(size.width * 0.52)] as const)
          : placement === "right"
            ? ([16, 0, 8, Math.floor(size.width * 0.43)] as const)
          : ([48, 0, 8, 0] as const);
      };
      const lineSeries = {
        stroke: color,
        width: 1.5,
        paths: uPlot.paths.spline(),
        points: { show: false },
        spanGaps: false,
      };
      const barSeries = {
        stroke: color,
        fill: color,
        width: 0,
        paths: uPlot.paths.bars({
          size: [0.58, 8, 2],
          gap: 1.5,
          radius: [0, 0],
        }),
        points: { show: false },
        spanGaps: false,
      };
      const chartSeries = variant === "bars" ? [barSeries, lineSeries] : [lineSeries];
      const chartData = variant === "bars" ? [xValues, yValues, yValues] : [xValues, yValues];

      const plot = new uPlot(
        {
          width: getSize().width,
          height: getSize().height,
          padding: getChartPadding(),
          scales: {
            x: { time: true },
            y: {
              range: [yMin, yMax],
            },
          },
          axes: [{ show: false }, { show: false }],
          legend: { show: false },
          cursor: { show: false },
          select: { show: false },
          series: [{}, ...chartSeries],
        },
        chartData,
        element,
      );

      const resizeObserver = new ResizeObserver(() => {
        plot.setSize(getSize());
      });
      resizeObserver.observe(element);
      element.dataset.runtimeSparklineBound = "true";
    });
  };

  const scheduleBind = () => window.requestAnimationFrame(bindSparklines);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scheduleBind, { once: true });
  } else {
    scheduleBind();
  }
  document.addEventListener("astro:page-load", scheduleBind);
</script>

<style>
  .runtime-sparkline {
    --runtime-accent: rgb(var(--runtime-accent-rgb));
    --runtime-secondary: rgb(var(--runtime-secondary-rgb));
    --runtime-warm: rgb(var(--runtime-warm-rgb));
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
    margin: 0;
    opacity: 0.9;
    overflow: hidden;
    pointer-events: none;
  }

  .runtime-sparkline--bars {
    position: absolute;
    height: auto;
    min-height: 0;
    opacity: 0.78;
  }

  .runtime-sparkline--bars::after {
    position: absolute;
    right: 0;
    bottom: 0.1rem;
    left: 0;
    height: 1px;
    content: "";
    background: rgba(var(--nature-highlight-rgb), 0.2);
    pointer-events: none;
  }

  .runtime-sparkline :global(.uplot) {
    position: relative;
    overflow: hidden;
    width: 100% !important;
    height: 100% !important;
    background: transparent;
  }
</style>

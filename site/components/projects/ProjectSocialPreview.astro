---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import type { ProjectCatalogItem } from "../../lib/projects";
import { toPublicSitePath } from "../../lib/runtime-urls";

interface Props {
  project: ProjectCatalogItem;
}

const { project } = Astro.props as Props;
const socialPreviewSrc = `/projects/social/${project.slug}.png`;
const socialPreviewPath = fileURLToPath(new URL(`../../../public${socialPreviewSrc}`, import.meta.url));
const hasSocialPreview = existsSync(socialPreviewPath);
const themedSocialPreview = {
  light: `/projects/social/${project.slug}-light.png`,
  dark: `/projects/social/${project.slug}-dark.png`,
};
const hasThemedSocialPreview = Object.values(themedSocialPreview).every((src) =>
  existsSync(fileURLToPath(new URL(`../../../public${src}`, import.meta.url)))
);
const hasRenderableSocialPreview = hasSocialPreview || hasThemedSocialPreview;
const servedSocialPreviewSrc = toPublicSitePath(socialPreviewSrc);
const servedThemedSocialPreview = {
  light: toPublicSitePath(themedSocialPreview.light),
  dark: toPublicSitePath(themedSocialPreview.dark),
};
---

{
  hasRenderableSocialPreview && (
    <figure class="project-social-preview">
      {hasThemedSocialPreview ? (
        <img
          class="project-social-preview-image"
          data-themed-project-image
          data-light-src={servedThemedSocialPreview.light}
          data-dark-src={servedThemedSocialPreview.dark}
          alt={`${project.title} 项目界面与功能概览`}
          width="1280"
          height="640"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <img
          src={servedSocialPreviewSrc}
          alt={`${project.title} 项目界面与功能概览`}
          width="1280"
          height="640"
          loading="lazy"
          decoding="async"
        />
      )}
    </figure>
  )
}

<script>
  const themedSocialPreviewSelector = "img[data-themed-project-image]";

  const updateThemedSocialPreviews = () => {
    const theme = document.documentElement.dataset.uiTheme === "dark" ? "dark" : "light";

    document.querySelectorAll<HTMLImageElement>(themedSocialPreviewSelector).forEach((image) => {
      if (image.dataset.projectSocialTheme === theme) return;

      const source = theme === "dark" ? image.dataset.darkSrc : image.dataset.lightSrc;
      if (!source) return;

      image.dataset.projectSocialTheme = theme;
      image.src = source;
    });
  };

  updateThemedSocialPreviews();
  document.addEventListener("astro:page-load", updateThemedSocialPreviews);
  new MutationObserver(updateThemedSocialPreviews).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-ui-theme"],
  });
</script>

<style>
  .project-social-preview {
    margin: 0;
    overflow: hidden;
    border-radius: var(--nature-radius-lg);
    box-shadow: 0 14px 30px rgba(30, 56, 42, 0.08);
  }

  :global(html[data-ui-theme="dark"]) .project-social-preview {
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.18);
  }

  .project-social-preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 767px) {
    .project-social-preview {
      border-radius: var(--nature-radius-md);
    }
  }
</style>

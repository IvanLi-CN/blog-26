---
import RuntimeActivityChart from "./RuntimeActivityChart.astro";
import RuntimeMetricValue from "./RuntimeMetricValue.astro";
import RuntimePanelAtmosphere from "./RuntimePanelAtmosphere.astro";
import RuntimeProjectLogo from "./RuntimeProjectLogo.astro";
import RuntimeSparkline from "./RuntimeSparkline.astro";
import type { ProjectRuntimeMetrics } from "../../lib/project-runtime-metrics";
import { formatRuntimeValue } from "../../lib/runtime-format";

interface Props {
  metrics: ProjectRuntimeMetrics;
  sourceUrl?: string;
}

const { metrics, sourceUrl = "" } = Astro.props as Props;
const freshnessStatusClasses = [
  "within-4-hours",
  "4-to-12-hours",
  "12-to-24-hours",
  "over-24-hours",
  "no-success",
] as const;
const freshnessCells =
  metrics.kind === "octo-rill"
    ? Array.from(metrics.freshness)
    : [];
---
<div
  class={`project-runtime-panel project-runtime-panel--${metrics.kind}`}
  data-project-runtime-panel
  data-runtime-kind={metrics.kind}
  data-runtime-source-url={sourceUrl || undefined}
  data-runtime-state={sourceUrl ? "pending" : "ready"}
>
  <div class="runtime-panel-body">
    <div class="runtime-panel-art-stage">
      <RuntimePanelAtmosphere kind={metrics.kind} />
    </div>
    <RuntimeProjectLogo kind={metrics.kind} />

    {metrics.kind === "codex-vibe-monitor" && (
      <>
        <div class="runtime-metric-grid runtime-metric-grid--cvm">
          <div class="runtime-metric runtime-metric--accent" data-runtime-stat-key="tokensPerMinute">
            <span class="runtime-metric-label">实时 Token/分钟</span>
            <RuntimeMetricValue value={metrics.tokensPerMinute.value} />
            <RuntimeSparkline label="实时 Token/分钟" stat={metrics.tokensPerMinute} />
          </div>
          <div class="runtime-metric" data-runtime-stat-key="parallelCalls">
            <span class="runtime-metric-label">并行调用数</span>
            <RuntimeMetricValue value={metrics.parallelCalls.value} />
            <RuntimeSparkline label="并行调用数" stat={metrics.parallelCalls} tone="secondary" />
          </div>
          <div class="runtime-metric" data-runtime-stat-key="todayTokens">
            <span class="runtime-metric-label">今日 Token 消耗量</span>
            <RuntimeMetricValue value={metrics.todayTokens.value} className="runtime-metric-value--compact" />
            <RuntimeSparkline label="今日 Token 消耗量" stat={metrics.todayTokens} placement="right" />
          </div>
        </div>
        <RuntimeActivityChart
          points={metrics.tokenActivity90d}
          label="最近 90 天 Token 消耗量活动图"
          kind="tokens"
        />
      </>
    )}

    {metrics.kind === "tavily-hikari" && (
      <>
        <div class="runtime-metric-grid runtime-metric-grid--hikari">
          <div class="runtime-metric runtime-metric--accent" data-runtime-stat-key="todayRequests">
            <span class="runtime-metric-label">今日请求次数</span>
            <RuntimeMetricValue value={metrics.todayRequests.value} />
            <RuntimeSparkline label="今日请求次数" stat={metrics.todayRequests} />
          </div>
          <div class="runtime-metric" data-runtime-stat-key="todayCredits">
            <span class="runtime-metric-label">今日积分消耗量</span>
            <RuntimeMetricValue value={metrics.todayCredits.value} />
            <RuntimeSparkline label="今日积分消耗量" stat={metrics.todayCredits} tone="secondary" />
          </div>
          <div class="runtime-metric" data-runtime-stat-key="monthCredits">
            <span class="runtime-metric-label">本月积分消耗量</span>
            <RuntimeMetricValue value={metrics.monthCredits.value} className="runtime-metric-value--hikari-lower" />
            <RuntimeSparkline label="本月积分消耗量" stat={metrics.monthCredits} tone="secondary" variant="bars" />
          </div>
          <div class="runtime-metric runtime-metric--quiet" data-runtime-stat-key="totalCredits">
            <span class="runtime-metric-label">积分总量</span>
            <RuntimeMetricValue value={metrics.totalCredits.value} className="runtime-metric-value--hikari-lower" />
            <RuntimeSparkline label="积分总量" stat={metrics.totalCredits} tone="secondary" variant="bars" />
          </div>
        </div>
        <RuntimeActivityChart
          points={metrics.requestActivity90d}
          label="最近 90 天每日请求数活动图"
          kind="requests"
        />
      </>
    )}

    {metrics.kind === "octo-rill" && (
      <>
        <div class="runtime-metric-grid runtime-metric-grid--octo">
          <div class="runtime-metric runtime-metric--accent" data-runtime-stat-key="deduplicatedRepositories">
            <span class="runtime-metric-label">去重仓库数</span>
            <RuntimeMetricValue value={metrics.deduplicatedRepositories.value} />
            <RuntimeSparkline label="去重仓库数" stat={metrics.deduplicatedRepositories} />
          </div>
          <div class="runtime-metric" data-runtime-stat-key="pressure">
            <span class="runtime-metric-label">压力值</span>
            <RuntimeMetricValue value={metrics.pressure.value} format="fixed-2" />
            <RuntimeSparkline label="压力值" stat={metrics.pressure} tone="warm" />
          </div>
        </div>
        <section class="runtime-freshness" aria-label="仓库刷新新鲜度活动图">
          <h3 class="runtime-chart-title">刷新新鲜度</h3>
          <div
            class="runtime-freshness-grid"
            role="img"
            aria-label={`仓库刷新新鲜度热点图，共 ${formatRuntimeValue(metrics.deduplicatedRepositories.value)} 个仓库`}
          >
            {freshnessCells.map((statusCode) => (
              <span
                class={`runtime-freshness-cell runtime-freshness-cell--${freshnessStatusClasses[statusCode] ?? "unknown"}`}
                data-status-code={statusCode}
                aria-hidden="true"
              ></span>
            ))}
          </div>
        </section>
      </>
    )}
  </div>
</div>

<style>
  .project-runtime-panel {
    --runtime-panel-rgb: 20, 44, 40;
    --runtime-accent-rgb: 102, 214, 163;
    --runtime-secondary-rgb: 89, 181, 214;
    --runtime-bar-rgb: 94, 204, 185;
    --runtime-warm-rgb: 236, 181, 87;
    --runtime-highlight-rgb: 247, 255, 250;
    --runtime-text-rgb: 235, 245, 239;
    --runtime-text: rgb(var(--runtime-text-rgb));
    --runtime-text-soft: rgba(var(--runtime-text-rgb), 0.72);
    --runtime-text-faint: rgba(var(--runtime-text-rgb), 0.5);
    --runtime-freshness-late-rgb: 238, 126, 92;
    --runtime-freshness-overdue-rgb: 207, 102, 134;
    --runtime-freshness-empty-rgb: 111, 116, 128;
    display: grid;
    position: relative;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: 0.8rem;
    width: 100%;
    aspect-ratio: 4 / 5;
    min-width: 0;
    overflow: hidden;
    padding: clamp(0.85rem, 3.5%, 1.2rem);
    border: 1px solid rgba(var(--runtime-highlight-rgb), 0.17);
    border-radius: 1.6rem;
    color: var(--runtime-text);
    background:
      radial-gradient(circle at 86% 12%, rgba(var(--runtime-accent-rgb), 0.08), transparent 30%),
      linear-gradient(180deg, rgba(var(--runtime-panel-rgb), 0.98), rgba(var(--runtime-panel-rgb), 0.93));
    box-shadow: inset 0 1px 0 rgba(var(--runtime-highlight-rgb), 0.08);
  }

  .project-runtime-panel[data-runtime-state="pending"] {
    display: none;
  }

  .runtime-panel-body {
    display: contents;
  }

  .runtime-panel-art-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .project-runtime-panel--tavily-hikari {
    --runtime-panel-rgb: 18, 38, 58;
    --runtime-accent-rgb: 109, 187, 239;
    --runtime-secondary-rgb: 119, 215, 188;
    --runtime-bar-rgb: 94, 204, 185;
  }

  .project-runtime-panel--octo-rill {
    --runtime-panel-rgb: 18, 43, 43;
    --runtime-accent-rgb: 104, 221, 176;
    --runtime-secondary-rgb: 102, 181, 219;
    --runtime-warm-rgb: 241, 180, 80;
  }

  :global(html[data-ui-theme="light"]) .project-runtime-panel {
    --runtime-panel-rgb: 230, 242, 235;
    --runtime-accent-rgb: 39, 143, 103;
    --runtime-secondary-rgb: 48, 119, 148;
    --runtime-bar-rgb: 42, 145, 130;
    --runtime-warm-rgb: 177, 116, 28;
    --runtime-highlight-rgb: 35, 78, 59;
    --runtime-text-rgb: 27, 55, 42;
    --runtime-text-soft: rgba(var(--runtime-text-rgb), 0.7);
    --runtime-text-faint: rgba(var(--runtime-text-rgb), 0.54);
    --runtime-freshness-late-rgb: 201, 94, 61;
    --runtime-freshness-overdue-rgb: 177, 72, 105;
    --runtime-freshness-empty-rgb: 133, 139, 144;
  }

  :global(html[data-ui-theme="light"]) .project-runtime-panel--tavily-hikari {
    --runtime-panel-rgb: 230, 240, 249;
    --runtime-accent-rgb: 42, 119, 183;
    --runtime-secondary-rgb: 43, 145, 133;
    --runtime-bar-rgb: 42, 145, 133;
  }

  :global(html[data-ui-theme="light"]) .project-runtime-panel--octo-rill {
    --runtime-panel-rgb: 229, 242, 235;
    --runtime-accent-rgb: 35, 143, 100;
    --runtime-secondary-rgb: 55, 123, 151;
    --runtime-bar-rgb: 42, 145, 125;
    --runtime-warm-rgb: 171, 110, 23;
  }

  @media (max-width: 767px) {
    .project-runtime-panel {
      border-radius: var(--nature-radius-md);
    }
  }

  .runtime-metric-grid {
    position: relative;
    grid-row: 2;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    min-width: 0;
  }

  .runtime-metric-grid--cvm .runtime-metric:last-child {
    grid-column: 1 / -1;
    border-top: 1px solid rgba(var(--runtime-highlight-rgb), 0.14);
    padding-top: 0.95rem;
  }

  .runtime-metric {
    position: relative;
    display: block;
    isolation: isolate;
    min-width: 0;
    min-height: 0;
    padding: 0.35rem 0.72rem 1rem 0;
  }

  .runtime-metric-label,
  .runtime-metric-value,
  .runtime-metric-unit {
    position: relative;
    z-index: 2;
    display: block;
  }

  .runtime-metric-value {
    margin-top: 0.42rem;
  }

  .runtime-metric-unit {
    margin-top: 0.2rem;
  }

  .runtime-metric-grid > .runtime-metric:nth-child(even) {
    border-left: 1px solid rgba(var(--runtime-highlight-rgb), 0.14);
    padding-left: 0.72rem;
  }

  .runtime-metric-grid--hikari > .runtime-metric:nth-child(n + 3) {
    border-top: 1px solid rgba(var(--runtime-highlight-rgb), 0.14);
    padding-top: 0.95rem;
  }

  .runtime-metric-grid--hikari > .runtime-metric:nth-child(n + 3) > .runtime-metric-value {
    font-size: clamp(1rem, 2.7vw, 1.52rem);
  }

  .runtime-metric--accent {
    color: rgb(var(--runtime-accent-rgb));
  }

  .runtime-metric--accent .runtime-metric-label {
    color: rgba(var(--runtime-accent-rgb), 0.82);
  }

  .runtime-metric-label,
  .runtime-metric-unit {
    color: var(--runtime-text-faint);
    font-size: clamp(0.56rem, 1.35vw, 0.66rem);
    line-height: 1.25;
    white-space: nowrap;
  }

  .runtime-metric-value {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-display), "Noto Serif SC", serif;
    font-size: clamp(1.12rem, 3vw, 1.66rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--runtime-text);
  }

  .runtime-metric--accent .runtime-metric-value {
    color: rgb(var(--runtime-accent-rgb));
  }

  .runtime-metric-value--compact {
    font-size: clamp(0.9rem, 2.25vw, 1.28rem);
  }

  .runtime-freshness {
    position: relative;
    grid-row: 3;
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.55rem;
    min-height: 0;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(var(--runtime-highlight-rgb), 0.14);
  }

  .runtime-chart-title {
    margin: 0;
    color: var(--runtime-text-soft);
    font-size: 0.71rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .runtime-freshness-grid {
    display: grid;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    grid-template-columns: repeat(var(--runtime-freshness-columns, 30), var(--runtime-freshness-cell-size, 0.5rem));
    grid-template-rows: repeat(var(--runtime-freshness-rows, 1), var(--runtime-freshness-cell-size, 0.5rem));
    grid-auto-rows: var(--runtime-freshness-cell-size, 0.5rem);
    gap: var(--runtime-freshness-gap, 0.18rem);
    align-content: end;
    justify-content: start;
  }

  :global(.runtime-freshness-cell) {
    min-width: 0;
    min-height: 0;
    border-radius: 0.12rem;
    background: rgb(var(--runtime-secondary-rgb));
  }

  :global(.runtime-freshness-cell--within-4-hours) {
    background: rgb(var(--runtime-accent-rgb));
  }

  :global(.runtime-freshness-cell--4-to-12-hours) {
    background: rgb(var(--runtime-warm-rgb));
  }

  :global(.runtime-freshness-cell--12-to-24-hours) {
    background: rgb(var(--runtime-freshness-late-rgb));
  }

  :global(.runtime-freshness-cell--over-24-hours) {
    background: rgb(var(--runtime-freshness-overdue-rgb));
  }

  :global(.runtime-freshness-cell--no-success) {
    background: rgb(var(--runtime-freshness-empty-rgb));
  }
</style>

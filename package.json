{
  "name": "@ivanli-cn/blog",
  "version": "1.0.0",
  "description": "Ivan's Blog - Astro public site, admin SPA, and Bun gateway",
  "type": "module",
  "private": true,
  "author": {
    "name": "Ivan Li",
    "email": "ivanli2048@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:IvanLi-CN/blog-26.git"
  },
  "homepage": "https://github.com/IvanLi-CN/blog-26",
  "bugs": {
    "url": "https://github.com/IvanLi-CN/blog-26/issues"
  },
  "license": "MIT",
  "keywords": [
    "blog",
    "astro",
    "react",
    "typescript",
    "tailwindcss",
    "sqlite",
    "ai",
    "vector-search",
    "comments",
    "admin"
  ],
  "browserslist": {
    "production": [
      "chrome >= 112",
      "edge >= 112",
      "firefox >= 113",
      "safari >= 16.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "bun": "^1.0.0"
  },
  "scripts": {
    "setup": "bash ./scripts/setup.sh",
    "worktree:bootstrap": "bash ./scripts/worktree-bootstrap.sh",
    "dev": "bun scripts/generate-version.ts && concurrently --names \"Astro,Admin,Gateway\" --prefix-colors \"yellow,blue,green\" \"bun run site:dev\" \"bun run admin:dev\" \"bun run gateway:dev\"",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006}",
    "build-storybook": "storybook build -o storybook-static",
    "build": "bun run prebuild && bun run build:compiled",
    "build:compiled": "bun run site:build && bun run admin:build:compiled && bun run backend:dist",
    "prebuild": "bun scripts/generate-version.ts && bun scripts/update-llm-model-catalog.ts",
    "start": "bun run gateway:start",
    "check": "biome check",
    "check:public-no-daisy": "bun ./scripts/check-public-no-daisy.ts",
    "lint": "bun run check",
    "fix": "biome check --write",
    "docker:build": "bash ./scripts/docker-build.sh",
    "migrate": "bun ./scripts/migrate.ts",
    "seed": "bun ./scripts/seed.ts",
    "seed:clear": "bun ./scripts/seed.ts --clear",
    "seed:check": "bun ./scripts/seed.ts --check",
    "drop-db": "bun ./scripts/drop-db.ts",
    "dev-db:reset": "DB_PATH=${DB_PATH:-./dev-data/sqlite.db} bun run drop-db --force && DB_PATH=${DB_PATH:-./dev-data/sqlite.db} bun run migrate && DB_PATH=${DB_PATH:-./dev-data/sqlite.db} bun run seed",
    "dev-db:check": "DB_PATH=${DB_PATH:-./dev-data/sqlite.db} bun ./scripts/db-tools.ts",
    "dev-db:schema": "DB_PATH=${DB_PATH:-./dev-data/sqlite.db} bun ./scripts/db-tools.ts schema",
    "dev-db:posts": "DB_PATH=${DB_PATH:-./dev-data/sqlite.db} bun ./scripts/db-tools.ts posts",
    "dev-db:comments": "DB_PATH=${DB_PATH:-./dev-data/sqlite.db} bun ./scripts/db-tools.ts comments",
    "test-db:reset": "DB_PATH=./test-data/sqlite.db bun run drop-db --force && DB_PATH=./test-data/sqlite.db bun run migrate && DB_PATH=./test-data/sqlite.db bun run seed",
    "test-db:check": "DB_PATH=./test-data/sqlite.db bun ./scripts/db-tools.ts",
    "test-db:schema": "DB_PATH=./test-data/sqlite.db bun ./scripts/db-tools.ts schema",
    "test-db:posts": "DB_PATH=./test-data/sqlite.db bun ./scripts/db-tools.ts posts",
    "test-db:comments": "DB_PATH=./test-data/sqlite.db bun ./scripts/db-tools.ts comments",
    "db:which": "echo \"当前数据库路径: ${DB_PATH:-./sqlite.db}\"",
    "dev-sync:trigger": "bun ./scripts/trigger-sync.ts dev",
    "content:scan-api-links": "bun ./scripts/content-scan-api-links.ts",
    "content:migrate-api-links": "bun ./scripts/content-migrate-api-links.ts",
    "test-data:generate": "bun ./scripts/generate-test-data.ts",
    "test-data:clean": "bun ./scripts/generate-test-data.ts --clean",
    "test-data:verify": "bun ./scripts/verify-test-data.ts",
    "test-env:clean": "DB_PATH=./test-data/sqlite.db bun run seed:clear && bun run test-data:clean",
    "test-env:reset": "DB_PATH=${DB_PATH:-./test-data/sqlite.db} LOCAL_CONTENT_BASE_PATH=${LOCAL_CONTENT_BASE_PATH:-./test-data/local} CONTENT_SOURCES=local bun run test-env:clean && DB_PATH=${DB_PATH:-./test-data/sqlite.db} LOCAL_CONTENT_BASE_PATH=${LOCAL_CONTENT_BASE_PATH:-./test-data/local} CONTENT_SOURCES=local bun run migrate && DB_PATH=${DB_PATH:-./test-data/sqlite.db} LOCAL_CONTENT_BASE_PATH=${LOCAL_CONTENT_BASE_PATH:-./test-data/local} CONTENT_SOURCES=local bun run seed && DB_PATH=${DB_PATH:-./test-data/sqlite.db} LOCAL_CONTENT_BASE_PATH=${LOCAL_CONTENT_BASE_PATH:-./test-data/local} CONTENT_SOURCES=local bun run test-data:generate && DB_PATH=${DB_PATH:-./test-data/sqlite.db} LOCAL_CONTENT_BASE_PATH=${LOCAL_CONTENT_BASE_PATH:-./test-data/local} CONTENT_SOURCES=local bun run test-sync:trigger && bun scripts/generate-version.ts",
    "test-env:reset-fs-only": "bun run test-env:reset",
    "test-sync:trigger": "bun ./scripts/trigger-sync.ts test",
    "test-server:start": "bun run test-env:reset && concurrently --names \"Astro,Admin,Gateway\" --prefix-colors \"yellow,blue,green\" \"DB_PATH=./test-data/sqlite.db LOCAL_CONTENT_BASE_PATH=./test-data/local PUBLIC_SITE_URL=http://127.0.0.1:25090 SITE_PORT=25093 bun run site:dev\" \"ADMIN_PORT=25094 bun run admin:dev\" \"NODE_ENV=test ADMIN_EMAIL=admin-test@test.local DB_PATH=./test-data/sqlite.db LOCAL_CONTENT_BASE_PATH=./test-data/local PUBLIC_SITE_URL=http://127.0.0.1:25090 PORT=25090 SITE_PORT=25093 ADMIN_PORT=25094 bun run gateway:dev\"",
    "dev-data:generate": "bun ./scripts/generate-test-data.ts --dev",
    "dev-data:clean": "bun ./scripts/generate-test-data.ts --dev --clean",
    "test": "bun test --isolate src tests/integration tests/lib tests/server --exclude='tests/e2e/**/*' --exclude='backend-dist/**/*'",
    "test:watch": "bun test --watch",
    "test:precommit": "bun ./scripts/run-precommit-tests.ts",
    "db:migrations:validate": "bun ./scripts/validate-drizzle-journal.ts",
    "test:e2e": "bun ./scripts/run-e2e.ts full",
    "test:e2e:playwright": "playwright test",
    "test:e2e:project": "bun ./scripts/run-e2e.ts project",
    "test:e2e:targeted": "E2E_INCLUDE_TAG=@targeted playwright test",
    "test:e2e:experimental": "E2E_INCLUDE_TAG=@experimental playwright test",
    "test:e2e:headless": "HEADLESS=true bun ./scripts/run-e2e.ts full",
    "test:e2e:verify": "bun ./scripts/verify-e2e-data.ts",
    "test:ci": "bun ./scripts/test-ci-workflow.ts",
    "test:worktree-bootstrap": "bash ./scripts/test-worktree-bootstrap.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "HEADLESS=false playwright test --headed",
    "test:e2e:report": "bun ./scripts/show-e2e-report.ts",
    "pr:create": "bun ./scripts/create-pr.ts",
    "public:export": "bun ./scripts/export-public-site-data.ts",
    "frontend:package-media": "bun ./scripts/package-public-media.ts",
    "frontend:verify-media": "bun ./scripts/verify-public-media-package.ts",
    "generate:project-posters": "bun ./scripts/generate-project-poster-assets.ts",
    "verify:project-posters": "bun ./scripts/verify-project-poster-assets.ts",
    "generate:project-social-previews": "bun ./scripts/generate-project-social-preview-assets.ts",
    "verify:project-social-previews": "bun ./scripts/verify-project-social-preview-assets.ts",
    "site:dev": "sh -c 'SITE_PORT=${SITE_PORT:-$(bun ./scripts/resolve-worktree-port.ts site)}; export SITE_PORT; bun run generate:project-posters && bun run generate:project-social-previews && bun run public:export && bunx astro dev --host 127.0.0.1 --port \"$SITE_PORT\"'",
    "site:build": "bun run generate:project-posters && bun run generate:project-social-previews && bun run public:export && bunx astro build && PROJECT_POSTER_REQUIRE_DIST=1 bun run verify:project-posters && PROJECT_SOCIAL_PREVIEW_REQUIRE_DIST=1 bun run verify:project-social-previews",
    "gateway:dev": "bun ./scripts/start-gateway.ts",
    "gateway:start": "NODE_ENV=production bun ./scripts/start-gateway.ts",
    "admin:dev": "sh -c 'ADMIN_PORT=${ADMIN_PORT:-$(bun ./scripts/resolve-worktree-port.ts admin)}; export ADMIN_PORT; bunx vite --config apps/admin/vite.config.ts --configLoader runner --host 127.0.0.1 --port \"$ADMIN_PORT\"'",
    "admin:build": "bun run prebuild && bunx vite build --config apps/admin/vite.config.ts --configLoader runner",
    "admin:build:compiled": "bunx vite build --config apps/admin/vite.config.ts --configLoader runner",
    "admin:preview": "sh -c 'ADMIN_PORT=${ADMIN_PORT:-$(bun ./scripts/resolve-worktree-port.ts admin)}; export ADMIN_PORT; bunx vite preview --config apps/admin/vite.config.ts --configLoader runner --host 127.0.0.1 --port \"$ADMIN_PORT\"'",
    "frontend:fetch-content": "bash ./scripts/fetch-public-content-bundle.sh",
    "frontend:build": "bun run prebuild && bun run site:build",
    "backend:dist": "bash ./scripts/prepare-backend-dist.sh",
    "backend:build": "bun run prebuild && bun run admin:build:compiled && bun run backend:dist"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/bxl": "^1.2.4",
    "@iconify-json/carbon": "^1.2.27",
    "@iconify-json/cib": "^1.2.3",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify/react": "^6.0.2",
    "@milkdown/core": "^7.22.2",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/prose": "^7.22.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.44",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "0.45.3",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "jotai": "^3.0.0",
    "js-yaml": "^5.4.2",
    "katex": "^0.18.9",
    "limax": "4.2.3",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "playwright": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "web-vitals": "^6.2.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.6",
    "@babel/parser": "^8.0.5",
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/tabler": "^1.2.40",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "^7.3.4",
    "commitlint-plugin-function-rules": "^5.0.1",
    "concurrently": "^10.0.5",
    "lefthook": "^2.1.14",
    "reading-time": "^1.5.0",
    "sharp": "0.35.4",
    "storybook": "^10.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "prosemirror-state": "1.4.4"
  },
  "bun": {
    "test": {
      "exclude": [
        "tests/e2e/**/*",
        "**/e2e/**/*",
        "**/*.spec.ts",
        "**/specs/**/*"
      ]
    }
  }
}
